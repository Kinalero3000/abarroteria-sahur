              </rowConstraints>
               <children>
                  <TableView fx:id="tableProducto" prefHeight="511.0" prefWidth="722.0" styleClass="dashboard-table" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <columns>
                      <TableColumn fx:id="tableColumnIdProducto" prefWidth="40.0" text="ID" />
                      <TableColumn fx:id="tableColumnNombreProducto" prefWidth="110.0" text="Nombre" />
                        <TableColumn fx:id="tableColumnStock" prefWidth="75.0" text="Stock" />
                        <TableColumn fx:id="tableColumnPrecio" prefWidth="87.0" text="Precio" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Pane prefHeight="268.0" prefWidth="35.0" styleClass="dashboard-panel" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="btnEliminarProducto" layoutX="36.0" layoutY="513.0" mnemonicParsing="false" onAction="#handleDeleteProducto" styleClass="delete-button" stylesheets="@../css/button-style.css" text="Eliminar producto">
