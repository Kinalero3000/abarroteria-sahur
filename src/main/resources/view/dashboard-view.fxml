                              <Font name="MS Gothic" size="12.0" />
                           </font>
                        </Button>
                        <Label layoutX="136.0" styleClass="dashboard-label" text="Datos" />
                        <Label layoutX="36.0" layoutY="37.0" styleClass="labels" text="ID" />
                        <Label layoutX="36.0" layoutY="110.0" styleClass="labels" text="Nombre" />
                        <Label layoutX="36.0" layoutY="182.0" styleClass="labels" text="Stock" />
                        <Label layoutX="36.0" layoutY="254.0" styleClass="labels" text="Precio" />
