                        <TextField fx:id="txtFieldStock" layoutX="36.0" layoutY="205.0" promptText="Stock" styleClass="dashboard-input" />
                        <TextField fx:id="txtFieldPrecio" layoutX="36.0" layoutY="276.0" promptText="Precio" styleClass="dashboard-input" />
                        <Button fx:id="btnGuardarProducto" layoutX="36.0" layoutY="339.0" mnemonicParsing="false" onAction="#handleGuardarProducto" styleClass="dashboard-button" stylesheets="@../css/button-style.css" text="Agregar producto">
