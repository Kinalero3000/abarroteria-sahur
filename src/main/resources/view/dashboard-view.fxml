<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../css/dashboard-style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.jgunzalesindustries.abarroteria.kinal.controller.DashBoardController">
