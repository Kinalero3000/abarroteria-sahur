                              <Font name="MS Gothic" size="12.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnActualizarProducto" layoutX="35.0" layoutY="397.0" mnemonicParsing="false" onAction="#handleActualizarProducto" styleClass="update-button" stylesheets="@../css/button-style.css" text="Actualizar producto">
                           <font>
                              <Font name="MS Gothic" size="12.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnLimpiarCampos" layoutX="36.0" layoutY="455.0" mnemonicParsing="false" onAction="#handleLimpiarCampos" styleClass="clear-button" stylesheets="@../css/button-style.css" text="Limpiar campos">
