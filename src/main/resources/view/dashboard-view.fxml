               </font>
               <textFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="0.014399999752640724" green="0.47999998927116394" blue="0.2006399929523468" />
                           </color>
                        </Stop>
                        <Stop offset="0.006711409395973154">
                           <color>
                              <Color red="0.014399999752640724" green="0.47999998927116394" blue="0.2006399929523468" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" blue="0.8952381014823914" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
            <GridPane layoutX="12.0" layoutY="51.0" prefHeight="650.0" prefWidth="1062.0">
